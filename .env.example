# PostgreSQL values used by docker compose
POSTGRES_DB=portal_activity
POSTGRES_USER=portal_api
POSTGRES_PASSWORD=change-me-in-production

# API configuration
# Host port published by Docker. The container always listens on 8080.
API_HOST_PORT=8080
TOKEN_TTL_HOURS=168
CONFIRMATION_TTL_HOURS=24
# Only leave this enabled in local development. A real deployment must deliver
# the confirmation URL through an email provider and set this to false.
EXPOSE_CONFIRMATION_TOKEN=true
